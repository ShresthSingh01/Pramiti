# PRAMITI AICTE Scrutiny Engine - Environment Template
# Copy this file to .env (or backend/.env) and configure the variables.

# 1. Google Gemini API Key (Online Cloud Fallback)
# Obtain a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM_LIMIT=10
GEMINI_MAX_WAIT_SECONDS=15

# 2. Local SLM (Ollama) Settings (Air-gapped on-device extraction)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 3. Security
JWT_SECRET=evidencegraph-dev-super-secret-key-aicte-sih-2026
