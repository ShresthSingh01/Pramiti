# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.tsbuildinfo

# Virtual Environments
venv/
backend/venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Databases & WAL files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Node & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Dynamic App Storage (preserve directories via .gitkeep)
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/synthetic/*
!backend/storage/synthetic/.gitkeep

# IDEs & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
